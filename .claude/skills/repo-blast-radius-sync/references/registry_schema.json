{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentRegistrySchema",
  "description": "Defines the validation structure for the compiled repo-blast-radius-sync state file.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "imports": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "docs": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "tests": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "governed_by": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          }
        },
        "required": ["imports", "docs", "tests", "governed_by"],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "files"],
  "additionalProperties": false
}